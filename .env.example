GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me

# Destinataire des alertes Grafana (section 3.8.2 du rapport)
GRAFANA_ALERT_EMAIL=admin@example.com

# Envoi reel des notifications par e-mail (desactive par defaut).
# Pour l'activer : GF_SMTP_ENABLED=true + un mot de passe d'application SMTP.
GF_SMTP_ENABLED=false
GF_SMTP_HOST=smtp.gmail.com:587
GF_SMTP_USER=
GF_SMTP_PASSWORD=
GF_SMTP_FROM_ADDRESS=
